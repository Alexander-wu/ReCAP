{
  "schema_version": 1,
  "dataset": "calvin",
  "backend": "compare",
  "observed_frames": 2,
  "horizon": 64,
  "arguments": [
    "--input-npz",
    "{data}/episode.npz",
    "--tokenizer-model",
    "{assets}/calvin_tokenizer",
    "--world-model",
    "{assets}/calvin_world",
    "--action-ranges",
    "{assets}/calvin/action_ranges.pth",
    "--output-dir",
    "{output}",
    "--num-frames",
    "64",
    "--strategies",
    "full_history,recap",
    "--anchor-frames",
    "1",
    "--window-size-w",
    "6",
    "--temperature",
    "0.5",
    "--top-k",
    "50",
    "--top-p",
    "0.9",
    "--seed",
    "42",
    "--no-emit-preview",
    "--no-emit-grid"
  ],
  "notes": "Portable paired H64 recipe. Historical result manifests remain the authority for each paper run and seed; this is not a claim of bitwise reproduction across devices."
}